# DeepL API key for server-side / build-time translation scripts.
# NEVER prefix with NEXT_PUBLIC_ — that would leak the key to the browser bundle.
#
# Get a key at: https://www.deepl.com/pro-api  (Free tier = 500K chars/month)
# Copy this file to .env.local and paste your real key there.
DEEPL_API_KEY=your-deepl-key-here

# Optional: DeepL Glossary ID for enforcing accounting/HK-specific term translations.
# Created and managed by scripts/deepl-glossary.ts. Leave empty until a glossary
# has been uploaded; the translation script will work without it.
DEEPL_GLOSSARY_ID=
